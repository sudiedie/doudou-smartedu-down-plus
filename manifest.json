{
  "manifest_version": 3,
  "name": "国家中小学智慧教育平台资源下载",
  "version": "1.0.0",
  "description": "",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.smartedu.cn/*",
    "https://*.ykt.cbern.com.cn/*",
    "https://*.cbern.com.cn/*",
    "https://*.ncet.edu.cn/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "国家中小学智慧教育平台资源下载",
    "default_icon": {
      "16": "icons/doudou_16.png",
      "48": "icons/doudou_48.png",
      "128": "icons/doudou_128.png"
    }
  },
  "icons": {
    "16": "icons/doudou_16.png",
    "48": "icons/doudou_48.png",
    "128": "icons/doudou_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.smartedu.cn/*"
      ],
      "js": [
        "src/wasm-loader.js",
        "src/downloader.js"
      ],
      "css": [
        "src/downloader.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "build/smartedu.wasm",
        "src/inject.js"
      ],
      "matches": [
        "https://*.smartedu.cn/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
